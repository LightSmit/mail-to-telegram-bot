TELEGRAM_BOT_TOKEN=

# Mailboxes are added by users in the Mini App and stored in the database.
# How many mailboxes a user can connect depends on the plan: Free 1, Pro 5, Business 15.

# More admins (Telegram user IDs, comma separated): /admin stats, /broadcast, /backup,
# daily database backups are sent to them. TELEGRAM_CHAT_ID is always an admin.
ADMIN_IDS=
# Daily backup hour (server time), number of copies kept on the server
BACKUP_HOUR=4
BACKUP_KEEP=7
BACKUP_SEND_TO_ADMINS=true

# Your Telegram user ID: the bot owner, always an admin
TELEGRAM_CHAT_ID=

# REQUIRED. Encrypts mailbox passwords in the database (AES-256-GCM).
# At least 32 characters. Generate: openssl rand -base64 48
# Losing or changing this key makes stored mailbox passwords unreadable.
ENCRYPTION_KEY=
# Only if you have old records encrypted with a previous key (optional):
# ENCRYPTION_KEY_LEGACY=

# Optional HTTP proxy used only for Telegram Bot API requests.
# Local Windows launch example:
# TELEGRAM_PROXY_URL=http://127.0.0.1:10809
# Docker Desktop host-proxy example:
# TELEGRAM_PROXY_URL=http://host.docker.internal:10809
# Leave empty when Telegram Bot API is directly accessible.
TELEGRAM_PROXY_URL=

DATABASE_PATH=data/mail-bot.db
ATTACHMENT_TEMP_DIR=data/attachments
MAX_ATTACHMENT_SIZE_MB=45

IDLE_RECONNECT_DELAY_SECONDS=5
# Fallback check over a fresh connection (each check is a new login).
# 15 seconds noticeably speeds up Gmail, which often reports new mail late over IDLE.
IMAP_SAFETY_POLL_SECONDS=15
# NOOP over the open IDLE connection: catches mail some servers (Gmail) report late
IMAP_NOOP_SECONDS=5

# Public domain of the Mini App (used by Caddy for HTTPS). No domain? Use your server IP
# with dashes + .sslip.io, e.g. 203-0-113-10.sslip.io
DOMAIN=

# "Reply" button: replies are sent over SMTP from the user's mailbox. Needs open
# outgoing ports 465/587 (many hosting providers block them). Check from the server:
#   timeout 5 bash -c '</dev/tcp/smtp.mail.ru/465' && echo open
REPLY_ENABLED=false

# Plans and payments in Telegram Stars. While false, everyone uses the bot for free
# with Pro limits (as before). Admins always have Business.
BILLING_ENABLED=false
# Free Pro trial for new users, days (0 - no trial)
TRIAL_DAYS=7
# Prices in Stars
PRICE_PRO_MONTH=100
PRICE_PRO_YEAR=1000
PRICE_BUSINESS_MONTH=300
PRICE_BUSINESS_YEAR=3000
# Contact for payment questions (/paysupport), for example @your_username
SUPPORT_CONTACT=
# Invite friends: every N friends who join with a referral link and connect a mailbox
# give the inviter a month of Pro (0 - turn off)
REFERRAL_GOAL=5
