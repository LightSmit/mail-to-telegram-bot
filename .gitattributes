# Normalize text files in the repository
* text=auto

# Source code and configuration
*.kt text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf

# Scripts
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary